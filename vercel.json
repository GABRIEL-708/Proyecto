{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/sw.js",
      "headers": {
        "cache-control": "no-store, no-cache, must-revalidate, max-age=0",
        "service-worker-allowed": "/"
      },
      "dest": "/sw.js"
    },
    {
      "src": "/manifest.json",
      "headers": {
        "content-type": "application/manifest+json; charset=utf-8",
        "cache-control": "no-cache, max-age=0"
      },
      "dest": "/manifest.json"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}

