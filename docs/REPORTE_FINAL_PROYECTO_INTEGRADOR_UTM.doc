<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reporte Técnico Final - Proyecto Integrador PWA - UTM</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap');

        :root {
            --primary: #00875a;
            --primary-dark: #005a3c;
            --secondary: #0f172a;
            --accent: #2563eb;
            --text: #1e293b;
            --text-light: #64748b;
            --bg-light: #f8fafc;
            --border: #cbd5e1;
            --card-bg: #ffffff;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--text);
            background-color: #e2e8f0;
            line-height: 1.65;
            font-size: 11pt;
        }

        .document-container {
            max-width: 900px;
            margin: 2rem auto;
            background: #ffffff;
            padding: 4rem 4.5rem;
            box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.15);
            border-radius: 10px;
        }

        /* Botón flotante para imprimir / guardar como PDF */
        .no-print-bar {
            position: fixed;
            top: 1rem;
            right: 1.5rem;
            background: #0f172a;
            padding: 0.65rem 1.25rem;
            border-radius: 9999px;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.35);
            display: flex;
            align-items: center;
            gap: 1rem;
            z-index: 1000;
        }

        .no-print-bar span {
            color: #94a3b8;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .btn-print {
            background: #10b981;
            color: #ffffff;
            border: none;
            padding: 0.55rem 1.35rem;
            border-radius: 9999px;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

        .btn-print:hover {
            background: #059669;
            transform: translateY(-1px);
        }

        /* Portada institucional */
        .cover {
